{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DotPilot",
  "version": "0.1.0",
  "identifier": "dev.dotnotfact.dotpilot",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DotPilot",
        "width": 1380,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#0c0f14"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  }
}
